# Copy to `.env` for a non-Docker local run:  cp .env.example .env
# Never commit a real .env file.

# Development mode. Set to false only together with a real DJANGO_SECRET_KEY.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Comma-separated hostnames allowed to reach the app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins trusted for CSRF (used behind proxies/tunnels).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# SQLite file location. In Docker Compose it points into the named volume.
DJANGO_DB_PATH=./data/db.sqlite3

# 1 = run `manage.py seed_demo_data` from docker/entrypoint.sh.
# Demo data is refused when DJANGO_DEBUG=false.
SEED_DEMO_DATA=1
