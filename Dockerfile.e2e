# E2E image: official Playwright Python image with browsers preinstalled.
# The tag MUST match the pinned playwright== version in pyproject.toml / uv.lock,
# otherwise the browser revision and the client library would differ.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/

WORKDIR /app

# Dependency layer first; browsers come with the base image.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen

COPY . .

ENV PATH="/app/.venv/bin:$PATH"

# Suite talks to the `web` service over the Compose network (E2E_BASE_URL).
CMD ["uv", "run", "--no-sync", "pytest", "tests/e2e"]
